# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=seu-projeto-gcp
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=mock-model

# Caminhos (opcional — padrão relativo à raiz do projeto)
PASTA_DADOS=dados
PASTA_LOGS=logs
PASTA_PROMPTS=app/prompts
PASTA_CONHECIMENTO=dados/conhecimento
PASTA_VETORES=dados/vetores

# Gemini: mock (offline) ou vertex (Vertex AI)
# Se omitido, usa mock quando GOOGLE_CLOUD_PROJECT estiver vazio
GEMINI_MODO=mock

# Logging
NIVEL_LOG=INFO

# --- Catálogo e integrações do domínio automotivo ---
# Arquivo do catálogo local em PASTA_DADOS, sem extensão (.csv ou .xlsx)
CATALOGO_VEICULOS=catalogo_carros
# false desliga toda chamada de internet (usa apenas o catálogo local)
INTEGRACOES_ONLINE=true
API_TIMEOUT=20
# Quantos candidatos compõem o shortlist analisado pelos agentes
MAX_CANDIDATOS=5
# Fração do orçamento destinada à compra do carro (o restante é o build)
FRACAO_ENTRADA_ORCAMENTO=0.6

# Busca na web (agentes de aftermarket e crônicos)
BUSCA_WEB_PROVIDER=ddgs
BUSCA_WEB_MAX=5

# RAG: base de conhecimento vetorial (LangChain + Chroma)
# false desliga a recuperação e a plataforma segue só com os dados estruturados
RAG_ATIVO=true
# Quantos trechos a busca vetorial recupera por consulta
RAG_K=5
# Tamanho e sobreposição dos chunks dos arquivos de PASTA_CONHECIMENTO
CHUNK_TAMANHO=800
CHUNK_SOBREPOSICAO=120
# Embeddings: local (hashing determinístico, sem download), vertex ou fake
EMBEDDING_MODO=local

# Fontes externas de referência
FIPE_BASE_URL=https://parallelum.com.br/fipe/api/v1
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api
CARQUERY_BASE_URL=https://www.carqueryapi.com/api/0.3

# Fonte de dados: azure (Azure SQL) ou duckdb (Excel local)
FONTE_DADOS=azure

# Azure SQL Database
AZURE_SQL_SERVER=seu-servidor.database.windows.net
AZURE_SQL_DATABASE=seu-banco
AZURE_SQL_USUARIO=seu-usuario
AZURE_SQL_SENHA=sua-senha
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_SCHEMA=dbo
AZURE_SQL_TABELAS=catalogo_carros

# Governança/auditoria: "sqlite" (padrão, dev/local) ou "azure_sql" (produção
# — reaproveita as credenciais AZURE_SQL_* acima; rode sql/governanca_schema.sql antes)
GOVERNANCA_BACKEND=sqlite
AZURE_SQL_GOVERNANCA_TABELA=dbo.governanca_interacoes

# --- Avaliação / MLOps (opcional, só para desenvolvimento e CI) ---
# Destino do tracking do MLflow usado por `py -m avaliacao.executar --mlflow`.
# Se omitido, o rastreamento grava em logs/mlruns.
# MLFLOW_TRACKING_URI=file:./logs/mlruns
